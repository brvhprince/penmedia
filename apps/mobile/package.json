{
  "name": "@penmedia/mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "dev": "react-native start",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace PenMedia.xcworkspace -scheme PenMedia -configuration Release",
    "clean": "react-native-clean-project",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@penmedia/filters": "workspace:*",
    "@penmedia/protocol": "workspace:*",
    "@penmedia/shared-types": "workspace:*",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.10",
    "react": "19.2.0",
    "react-native": "0.83.0",
    "react-native-device-info": "^10.12.0",
    "react-native-permissions": "^4.1.5",
    "react-native-qrcode-svg": "^6.2.0",
    "react-native-reanimated": "^3.6.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^3.29.0",
    "react-native-svg": "^14.1.0",
    "react-native-vision-camera": "^3.8.2",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/eslint-config": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@react-native/typescript-config": "0.83.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
